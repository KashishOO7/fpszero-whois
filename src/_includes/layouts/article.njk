---
layout: layouts/base.njk
---
<article class="article">
  <h1>{{ title }}</h1>

  <p class="byline">
    {{ author or site.author }} &middot;
    <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
    {%- if category %} &middot; {% for sh in shelves %}<a href="/{{ sh }}/">{{ sh }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}
  </p>

  {% if source_url and source != "original" %}
  <p class="origin">First published in
     <a href="{{ source_url }}" target="_blank" rel="noopener noreferrer external">{{ source_url | originLabel(source) }}</a>.
     This is the author's own copy.</p>
  {% endif %}

  <div class="prose">
    {{ content | safe }}
  </div>

  <div class="article-foot">
    {% if tags | length %}
    <ul class="tags" aria-label="Subjects">
      {%- for t in tags %}
      <li><a href="/tag/{{ t }}/">{{ t }}</a></li>
      {%- endfor %}
    </ul>
    {% endif %}
    <p class="byline stack-sm">
      Written by {{ site.author }}.
      {% for sh in shelves %}<a href="/{{ sh }}/">More on the {{ sh }} shelf</a>{% if not loop.last %} &middot; {% endif %}{% endfor %}
    </p>
  </div>
</article>
