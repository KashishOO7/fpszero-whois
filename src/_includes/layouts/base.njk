<!doctype html>
<html lang="{{ site.lang }}" data-theme="dark">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="referrer" content="no-referrer">
    <meta name="color-scheme" content="dark light">
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'">
    <title>{% if title %}{{ title }} · {{ site.name }}{% else %}{{ site.author }}{% endif %}</title>
    {% if description %}<meta name="description" content="{{ description }}">{% endif %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}"><meta property="og:type" content="{% if page.url.startsWith('/archive/') %}article{% else %}website{% endif %}">
    <meta property="og:site_name" content="{{ site.domain }}">
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}">
    {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ site.url }}/og.png">
    <meta property="og:image:alt" content="{{ site.brand }}: {{ site.name }}">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="stylesheet" href="/site.css">
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.author }}">
    <script src="/os.js" defer></script>
  </head>
  <body>
    {{ content | safe }}
  </body>
</html>
