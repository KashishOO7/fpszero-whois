---
layout: layouts/base.njk
permalink: /shelves/
title: Shelves
description: "Every shelf in the library, and the subjects that run across them."
---
<div class="page-head">
  <h1>The Shelves</h1>
  <p class="gloss">{% for s in categories.shelves %}{{ s.name }}{% if loop.revindex == 2 %} and {% elif not loop.last %}, {% endif %}{% endfor %}.</p>
</div>

<div class="shelf-grid">
  {%- for shelf in categories.shelves %}
  <article class="shelf">
    <div class="shelf-head">
      <h3><a href="/{{ shelf.slug }}/">{{ shelf.name }}</a></h3>
      <span class="count">
        {%- set n = collections[shelf.slug] | length -%}
        {{ n }} volume{% if n != 1 %}s{% endif %}
      </span>
    </div>
    {% include "pen-rule.njk" %}
    <p class="gloss">{{ shelf.gloss }}</p>
  </article>
  {%- endfor %}
</div>

<h2 class="section stack-lg">Subjects</h2>
{% include "pen-rule.njk" %}
<ul class="tags">
  {%- for t in collections.tagList %}
  <li><a href="/tag/{{ t }}/">{{ t }}</a></li>
  {%- endfor %}
</ul>
